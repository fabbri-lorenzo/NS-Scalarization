%% Minimal, compact, color-coded overview
%%{init:{
  "theme":"default",
  "flowchart":{
    "defaultRenderer":"elk",
    "nodeSpacing":18,                   // horizontal spacing between siblings
    "rankSpacing":5,                    // vertical spacing between layers
    "elk":{
      "defaultLayoutOptions":{
        "elk.direction":"DOWN",         // main flow top→bottom
        "elk.algorithm":"layered",
        "spacing.nodeNodeBetweenLayers":12,  // smaller vertical gap between levels
        "spacing.nodeNode":24,               // horizontal spacing between siblings
        "nodePlacement.strategy":"NETWORK_SIMPLEX",
        "elk.layered.spacing.nodeNodeBetweenLayers":16,
        "elk.layered.spacing.baseValue":12,
        "elk.aspectRatio":"2.0",        // try 1.5–2.0 to stretch horizontally
        "elk.edgeRouting":"ORTHOGONAL"  // optional: neater horizontal edges
      }
    }
  }
}}%%
graph TD

  %% ========== MODE DISCOVERY  &  SELECT PER MODE ==========
  
  subgraph LEFT_["ASSIGN VACUUM VALUE"]
  direction TB
    Q{"for each node n"}:::loop
    Q --> R{ν ≠ 0 ?}:::decision
    R -->|yes| R1["split by vacuum sign<br/>pick closest to its vacuum"]:::shoot
    R -->|no| R0["pick min abs σ(r_max)"]:::shoot
    R1 --> S["selected_pairs (n, σ₀)"]:::shoot
    R0 --> S
  end
  
  
  %% make both headers 2 lines so their tops align
  subgraph RIGHT_["SELECT PHYSICAL ROOTS"]
  direction TB
    L{"for each σ₀"}:::loop
    L --> M["Integrate to 2R"]:::integ
    M --> N["Determine target value<br/>and compare σ(r_max)"]:::integ
    N --> O["Accept root if<br/>residual < thresholds<br/>and Ψ₂ &gt; 0"]:::shoot
    O --> P["Count nodes → assign mode n"]:::integ
  end


  %% ============ STYLES ============
  classDef setup    fill:#c9f7c9,stroke:#2a8,stroke-width:1px;
  classDef scan     fill:#cfe5ff,stroke:#248,stroke-width:1px;
  classDef shoot    fill:#ffe0b3,stroke:#c66,stroke-width:1px;
  classDef integ    fill:#e8d9ff,stroke:#62c,stroke-width:1px;
  classDef output   fill:#fff7b3,stroke:#aa3,stroke-width:1px;
  classDef decision fill:#ffffff,stroke:#333,stroke-width:2px;
  classDef loop     fill:#fafafa,stroke:#555,stroke-dasharray:4 2;
  classDef warn     fill:#ffe9e9,stroke:#c33,stroke-width:1px;
  classDef error    fill:#ffcccc,stroke:#a00,stroke-width:2px;
  classDef spacer fill:transparent,stroke:transparent;
  classDef invis fill:none,stroke:none;
